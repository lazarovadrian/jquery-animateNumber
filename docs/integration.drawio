        <mxCell id="title" value="Tundra 1:24 — интеграция. Номера GPIO не назначены. Банки не параллелить." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1">
