        </mxCell>
        <mxCell id="tp1" value="TP4056 №1&#10;только эта банка&#10;заряд до 4,2 В" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
