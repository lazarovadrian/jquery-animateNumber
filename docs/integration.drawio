        </mxCell>
        <mxCell id="esp" value="ESP32-C3 Super Mini Pro&#10;логика 3,3 В&#10;питание: вход модуля,&#10;не пин 3,3 В и не GPIO&#10;сигналы: GPIO не назначены" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
