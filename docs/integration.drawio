        </mxCell>
        <mxCell id="b600" value="Аккумулятор&#10;3,7 В, 600 мА·ч&#10;не параллелить с 18650" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
