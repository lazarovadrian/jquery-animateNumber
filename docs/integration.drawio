        </mxCell>
        <mxCell id="rules" value="Нельзя: мотор на GPIO; две банки параллельно;&#10;два TP4056 на одну банку; фары на GPIO;&#10;плюс банки на пин 3,3 В.&#10;При прошивке по USB банку и TP4056 отключить." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;" vertex="1" parent="1">
